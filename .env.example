# Frontend API
VITE_API_URL=http://localhost:8000

# Backend persistence and processing
TRAFFIC_DATABASE_PATH=data/traffic_analytics.db
TRAFFIC_DATA_DIR=data
TRAFFIC_OUTPUT_DIR=data/exports
TRAFFIC_MODEL_PATH=data/yolov8n.onnx
TRAFFIC_MAX_UPLOAD_BYTES=524288000
TRAFFIC_SUMMARY_DURATION_SECONDS=5
TRAFFIC_DETECTION_CONFIDENCE=0.35
TRAFFIC_DETECTION_IOU=0.45
TRAFFIC_DETECTION_MAX_FPS=10
TRAFFIC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# RTSP URLs (including credentials, if required) belong only in the backend
# environment. Do not put credentials in the dashboard or commit them.
# Camera ID "cam-01" maps to CAMERA_RTSP_CAM_01.
# CAMERA_RTSP_CAM_01=rtsp://camera-host.example/stream
# CAMERA_RTSP_CAM_02=rtsp://camera-host.example/stream

# Optional model class-ID mapping JSON; COCO defaults are used when omitted.
# A custom three-wheeler detector must use its own compatible weights and labels.
# TRAFFIC_CLASS_MAPPING_JSON={"0":"PEDESTRIAN","1":"BICYCLE","2":"FOUR-WHEELER","3":"TWO-WHEELER","5":"BUS","7":"TRUCK"}
